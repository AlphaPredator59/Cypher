# Set default behavior to automatically normalize line endings to LF in repository
* text=auto eol=lf

# Code and configuration source files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Binary model artifacts, fonts, and images
*.pth binary
*.pt binary
*.pkl binary
*.cbm binary
*.woff2 binary
*.woff binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tsbuildinfo binary
