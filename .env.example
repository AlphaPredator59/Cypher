# CYPHER Environment Configuration Template
# Copy this file to .env and configure the values for your environment.

# ==============================================================================
# Backend Configuration
# ==============================================================================
# Google Gemini API Key for SOC Alert Summarization (required for /summarize endpoint)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ==============================================================================
# Frontend Configuration
# ==============================================================================
# Backend API Base URL for the React console
VITE_API_BASE=http://localhost:8000
